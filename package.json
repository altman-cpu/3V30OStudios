{
  "name": "megazion-codex",
  "version": "1.0.0",
  "description": "MEGAZION sovereign deployment toolkit",
  "type": "commonjs",
  "scripts": {
    "mint:gems": "node scripts/mint_all_gems.js",
    "registry:sync": "node scripts/registry_sync.js",
    "codex:link": "node scripts/codex_linker.js",
    "ipfs:upload": "node scripts/ipfs_upload.js",
    "deploy:all": "hardhat run scripts/deploy_all_contracts.ts",
    "deploy:cascade": "hardhat run scripts/deploy_cascade.ts",
    "deploy:governance": "hardhat run scripts/deploy_governance.ts",
    "deploy:treasury": "hardhat run scripts/deploy_treasury.ts",
    "deploy:init": "hardhat run scripts/init_deployment.ts",
    "deploy:verify": "hardhat run scripts/verify_deployment.ts",
    "deploy:health": "hardhat run scripts/deployment_health_check.ts",
    "compile": "hardhat compile",
    "test": "hardhat test",
    "clean": "hardhat clean",
    "entropy:serve": "node entropy/bin/entropy.js serve",
    "entropy:demo": "node entropy/bin/entropy.js demo --seconds 3",
    "entropy:status": "node entropy/bin/entropy.js status",
    "entropy:seed": "node entropy/bin/entropy.js seed",
    "entropy:token": "node entropy/bin/entropy.js token --subject commander --tier sovereign --json",
    "entropy:mine": "node entropy/bin/entropy.js mine --seconds 5 --blocks 2",
    "entropy:verify": "node entropy/bin/entropy.js verify",
    "entropy:chain": "node entropy/bin/entropy.js chain --limit 10",
    "entropy:handlers": "node entropy/bin/entropy.js handlers",
    "entropy:reality": "node entropy/bin/entropy.js reality --limit 12",
    "entropy:wallet": "node entropy/bin/entropy.js wallet --profile commander",
    "entropy:memory": "node entropy/bin/entropy.js memory --profile commander",
    "entropy:recall": "node entropy/bin/entropy.js recall --profile commander --query gate",
    "entropy:weave": "node entropy/bin/entropy.js weave --profile commander --action catalog",
    "entropy:missions": "node entropy/bin/entropy.js missions --profile commander",
    "entropy:scan": "node entropy/bin/entropy.js scan --profile commander --mode deep",
    "entropy:squad": "node entropy/bin/entropy.js squad --profile commander --action roster",
    "entropy:lobby": "node entropy/bin/entropy.js lobby --profile commander --action list",
    "entropy:pending": "node entropy/bin/entropy.js pending --action list",
    "entropy:events": "node entropy/bin/entropy.js events",
    "entropy:journal": "node entropy/bin/entropy.js journal --limit 25",
    "entropy:css": "node entropy/bin/entropy.js css --surface bright --grade Cr-7",
    "entropy:openapi": "node entropy/bin/entropy.js openapi --out entropy/openapi.json",
    "entropy:test": "node --test entropy/test/*.test.js"
  },
  "dependencies": {
    "dotenv": "^16.3.1",
    "ethers": "^5.7.2",
    "ipfs-http-client": "^59.0.0",
    "@openzeppelin/contracts": "^5.0.0"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^3.0.0",
    "@nomiclabs/hardhat-ethers": "^2.2.3",
    "@nomiclabs/hardhat-etherscan": "^3.1.7",
    "@typechain/ethers-v5": "^11.1.2",
    "@typechain/hardhat": "^9.1.0",
    "@types/node": "^20.8.0",
    "eslint": "^8.50.0",
    "hardhat": "^2.19.0",
    "nodemon": "^3.0.1",
    "prettier": "^3.0.3",
    "ts-node": "^10.9.1",
    "typechain": "^8.3.2",
    "typescript": "^5.2.2"
  }
}
