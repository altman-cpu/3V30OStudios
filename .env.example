# Deployer Private Key (DO NOT COMMIT THE REAL .env FILE)
PRIVATE_KEY=your_private_key_here_without_0x_prefix

# RPC URLs - Mainnets
ETHEREUM_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_API_KEY
POLYGON_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/YOUR_API_KEY
AVALANCHE_RPC_URL=https://api.avax.network/ext/bc/C/rpc
BSC_RPC_URL=https://bsc-dataseed.binance.org/
CRONOS_RPC_URL=https://evm.cronos.org

# RPC URLs - Testnets
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY
MUMBAI_RPC_URL=https://polygon-mumbai.g.alchemy.com/v2/YOUR_API_KEY
FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc

# Block Explorer API Keys (for contract verification)
ETHERSCAN_API_KEY=your_etherscan_api_key
POLYGONSCAN_API_KEY=your_polygonscan_api_key
SNOWTRACE_API_KEY=your_snowtrace_api_key
BSCSCAN_API_KEY=your_bscscan_api_key

# NFT Storage (for IPFS uploads)
NFT_STORAGE_KEY=your_nft_storage_api_key

# ─────────────────────────────────────────────────────────────────────────
# ENTROPY STACK (API + HUD + reality miners) — see entropy/README.md
# All optional: with none of these set, `npm run entropy:serve` generates a
# genesis seed and a local development master key on first run.
# ─────────────────────────────────────────────────────────────────────────

# Signs every key auth token (entk.v1.…). Set this in production from a
# secrets manager; without it a development key is generated at 0600 perms
# in ENTROPY_DATA_DIR/keyring.json and printed once in the boot banner.
ENTROPY_MASTER_KEY=

# The genesis identity of this network. Same seed ⇒ same entropy addresses,
# same generated reality. Leave empty to generate one on first boot (stored
# in ENTROPY_DATA_DIR/genesis.json with only its fingerprint kept).
ENTROPY_GENESIS_SEED=

# Where canonical state lives: state/*.json, cas/, journal.jsonl, keyring.json.
ENTROPY_DATA_DIR=./data/entropy

# HTTP binding for the API + HUD (the HUD is served at /ui/).
PORT=8080
HOST=0.0.0.0

# dev  = POST /v1/auth/token is open (bootstrapping, local play)
# prod = POST /v1/auth/token requires an admin:root token
ENTROPY_MODE=dev

# Chromium alloy for the generated UI theme: bright | dusk | scan, Cr-2…Cr-9.
ENTROPY_SURFACE=bright
ENTROPY_CHROMIUM_GRADE=Cr-7

# Network label recorded in the genesis document.
ENTROPY_NETWORK=local-genesis

# Per-subject token bucket (reads cost 1, writes cost 2).
ENTROPY_RATE_CAPACITY=400
ENTROPY_RATE_REFILL=60

# How long a parked seal stays unmaskable before the sweep expires it.
ENTROPY_PENDING_TTL_MINUTES=30

# Optional public base URL used in the OpenAPI document and handler registry.
ENTROPY_BASE_URL=

# CORS origin for browser integrations ('*' by default).
ENTROPY_CORS_ORIGIN=*
